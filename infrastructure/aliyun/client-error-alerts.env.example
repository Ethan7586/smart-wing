# 只由 smart-wing-client-error-alerts.service 读取；不要并入前台/API 的 .env.production。
# 填写后以 chmod 600 保存到 /opt/smart-wing/.env.client-error-alerts。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alert-sender@example.com
SMTP_PASSWORD=server-only-smtp-password
SMTP_FROM=Smart Wing <alert-sender@example.com>
CLIENT_ERROR_ALERT_TO=oncall@example.com
