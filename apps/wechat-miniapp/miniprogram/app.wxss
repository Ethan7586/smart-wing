@import './styles/tokens.wxss';
@import './styles/icons.wxss';

page {
  background: var(--sw-background);
  color: var(--sw-text);
  font-family: var(--sw-font-cn);
  font-size: var(--sw-fs-body);
  line-height: var(--sw-lh-body);
  -webkit-font-smoothing: antialiased;
}

/* ---------------------------------------------------------------- primitives */

.sw-page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* Every page section shares one horizontal inset so nothing drifts. */
.sw-inset {
  padding-left: var(--sw-page-inset);
  padding-right: var(--sw-page-inset);
}

/* Ordinary cards use a hairline border. Shadows are reserved for overlays, the
   tab bar, the member-code entry and the digital card. */
.sw-card {
  background: var(--sw-surface);
  border: 1rpx solid var(--sw-border);
  border-radius: var(--sw-radius-large);
  box-sizing: border-box;
}

.sw-row {
  display: flex;
  align-items: center;
}

.sw-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ------------------------------------------------------------------- type */

.sw-h2 { font-size: var(--sw-fs-h2); line-height: var(--sw-lh-h2); font-weight: var(--sw-fw-h2); color: var(--sw-text); }
.sw-h3 { font-size: var(--sw-fs-h3); line-height: var(--sw-lh-h3); font-weight: var(--sw-fw-h3); color: var(--sw-text); }
.sw-body { font-size: var(--sw-fs-body); line-height: var(--sw-lh-body); color: var(--sw-text); }
.sw-small { font-size: var(--sw-fs-bodySmall); line-height: var(--sw-lh-bodySmall); color: var(--sw-text-secondary); }
.sw-caption { font-size: var(--sw-fs-caption); line-height: var(--sw-lh-caption); color: var(--sw-text-muted); }

/* Financial figures use tabular numerals so columns of money line up. */
.sw-amount {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-amount);
  line-height: var(--sw-lh-amount);
  font-weight: var(--sw-fw-amount);
  font-variant-numeric: tabular-nums;
  color: var(--sw-text);
}

/* ------------------------------------------------------------------ states */

/* Skeleton, not a blank screen. */
.sw-skeleton {
  background: var(--sw-surface-subtle);
  border-radius: var(--sw-radius-medium);
  animation: sw-pulse 1.4s ease-in-out infinite;
}

@keyframes sw-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/**
 * Asset slot. Used wherever an approved image does not exist yet: hero art,
 * product photography, partner logos. It is deliberately legible as "missing",
 * because 02-VI与产品冻结规则 forbids inventing artwork to fill the gap.
 */
.sw-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--sw-surface-subtle);
  border: 1rpx dashed var(--sw-border-strong);
  border-radius: var(--sw-radius-medium);
  box-sizing: border-box;
}

.sw-slot-label {
  margin-top: var(--sw-space-half);
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-disabled);
}

/* Slot on a brand-coloured surface needs inverted treatment. */
.sw-slot-on-brand {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.4);
}

.sw-slot-on-brand .sw-slot-label { color: rgba(255, 255, 255, 0.85); }

/* Demo-data banner. Never let seed numbers pass as the member's own. */
.sw-demo-flag {
  display: flex;
  align-items: center;
  padding: var(--sw-space-1) var(--sw-page-inset);
  background: var(--sw-warning-surface);
  color: var(--sw-warning-strong);
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
}

.sw-demo-flag .i {
  margin-right: var(--sw-space-half);
}

/* Minimum touch target for anything tappable. */
.sw-tap {
  min-width: var(--sw-touch-min);
  min-height: var(--sw-touch-min);
}
