@import './category-content.wxss';

/* Flexbox with explicit margins — flex gap is unreliable on older WeChat
   Android base libraries. Widths come from generated size-class tokens; calc()
   must never divide by a var(). */

.category {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  padding-bottom: calc(var(--sw-tabbar-height) + env(safe-area-inset-bottom, 0px));
  overflow: hidden;
  box-sizing: border-box;
}

/* ------------------------------------------------------- navigation ------- */

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--sw-background);
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: var(--sw-page-inset);
}

.nav-spacer {
  flex-shrink: 0;
}

.nav-title {
  font-size: var(--sw-fs-h2);
  line-height: var(--sw-lh-h2);
  font-weight: var(--sw-fw-h2);
  color: var(--sw-text);
}

.nav-actions {
  display: flex;
  align-items: center;
}

.nav-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: var(--sw-space-1);
  min-width: 64rpx;
  width: 64rpx;
}

.cart-badge {
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--sw-danger);
  color: var(--sw-text-inverse);
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ------------------------------------------------------------ states ------ */

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--sw-space-6);
  padding-bottom: var(--sw-space-6);
  flex: 1;
}

.state-text {
  margin-top: var(--sw-space-1);
  text-align: center;
}

.retry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sw-space-2);
  padding: 0 var(--sw-space-2);
  height: var(--sw-touch-min);
  border: 1rpx solid var(--sw-brand);
  border-radius: var(--sw-radius-medium);
}

.retry-text {
  margin-left: 8rpx;
  font-size: var(--sw-fs-bodySmall);
  color: var(--sw-brand);
}

.skeleton-wrap {
  padding-top: var(--sw-space-2);
  flex: 1;
}

.sk-search {
  height: var(--sw-touch-min);
  margin-bottom: var(--sw-space-2);
}
.sk-filter {
  height: 60rpx;
  width: 70%;
  margin-bottom: var(--sw-space-2);
}
.sk-body {
  height: 600rpx;
}
