.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: var(--sw-background);
}
.nav-row {
  display: flex;
  align-items: center;
  padding-left: var(--sw-page-inset);
  box-sizing: border-box;
}
.nav-title {
  font-size: var(--sw-fs-h2);
  line-height: var(--sw-lh-h2);
  font-weight: var(--sw-fw-h2);
}
.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  text-align: center;
}
.result-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--sw-radius-full);
}
.result-symbol.is-success {
  background: var(--sw-success-surface);
}
.result-symbol.is-processing {
  background: var(--sw-brand-light);
}
.result-title {
  margin-top: var(--sw-space-2);
  font-size: var(--sw-fs-h2);
  font-weight: var(--sw-fw-h2);
}
.result-copy {
  margin-top: var(--sw-space-half);
  color: var(--sw-text-secondary);
  font-size: var(--sw-fs-bodySmall);
}
.result-card {
  width: 100%;
  margin-top: var(--sw-space-4);
  padding: var(--sw-space-2);
  text-align: left;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--sw-touch-min);
  border-bottom: 1rpx solid var(--sw-border);
  font-size: var(--sw-fs-bodySmall);
}
.info-row:last-child {
  border-bottom: 0;
}
.info-row text:first-child {
  color: var(--sw-text-secondary);
}
.info-row text:last-child {
  min-width: 0;
  margin-left: var(--sw-space-1);
  text-align: right;
}
.order-no {
  font-family: var(--sw-font-num);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.result-actions {
  width: 100%;
  display: flex;
  margin-top: var(--sw-space-2);
}
.secondary-button,
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: var(--sw-radius-full);
  font-size: var(--sw-fs-bodySmall);
  font-weight: var(--sw-fw-h3);
}
.secondary-button {
  border: 1rpx solid var(--sw-brand);
  color: var(--sw-brand);
}
.primary-button {
  margin-left: var(--sw-space-1);
  background: var(--sw-brand);
  color: var(--sw-text-inverse);
}
.state-wrap {
  min-height: 68vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.state-title {
  margin-top: var(--sw-space-1);
  font-size: var(--sw-fs-h3);
  font-weight: var(--sw-fw-h3);
}
.state-copy {
  max-width: 560rpx;
  margin-top: var(--sw-space-half);
  color: var(--sw-text-secondary);
  font-size: var(--sw-fs-bodySmall);
}
.state-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sw-space-2);
  padding: 0 var(--sw-space-2);
  border: 1rpx solid var(--sw-border-strong);
  border-radius: var(--sw-radius-full);
  color: var(--sw-brand);
}
.state-button .i {
  margin-right: var(--sw-space-half);
}
.skeleton-wrap {
  padding-top: 120rpx;
}
.result-skeleton {
  height: 620rpx;
}
