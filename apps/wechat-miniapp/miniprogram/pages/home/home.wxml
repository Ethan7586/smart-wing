<!--
  首页 — 区块顺序取自任务书 §12，构图对照
  docs/mobile/design-previews/smart-wing-unified-mall-01-browse-v2-cart-restored.png 第 1 屏。
  顶部所有距离来自 wx.getWindowInfo / wx.getMenuButtonBoundingClientRect，无写死值。
-->
<view class="sw-page home {{sizeClass}}" style="{{sizeStyle}}">

  <!-- 1. 品牌与购物车。只展示已经接通的操作。 -->
  <view class="nav {{scrolled ? 'is-scrolled' : ''}}" style="padding-top: {{nav.statusBarHeight}}px;">
    <view class="nav-row" style="height: {{nav.navContentHeight}}px; padding-right: {{nav.rightInset}}px;">
      <text class="nav-title">智慧翼福利商城</text>
      <view class="nav-actions">
        <view class="nav-action sw-tap" bindtap="onOpenCart">
          <view class="i i-shopping-cart-ink"></view>
          <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text>
        </view>
      </view>
    </view>
  </view>
  <!-- Spacer keeps content clear of the fixed navigation. -->
  <view style="height: {{nav.navTotalHeight}}px;"></view>

  <!-- 接口降级 / 加载失败 -->
  <view wx:if="{{loadError}}" class="sw-inset state-block">
    <view class="i i-lg i-wifi-off-muted"></view>
    <text class="sw-small state-text">{{loadError}}</text>
    <view class="retry" bindtap="onRetry">
      <view class="i i-sm i-refresh-cw-brand"></view>
      <text class="retry-text">重试</text>
    </view>
  </view>

  <!-- 骨架屏，不留白屏 -->
  <view wx:elif="{{loading}}" class="sw-inset skeleton-wrap">
    <view class="sw-skeleton sk-chip"></view>
    <view class="sw-skeleton sk-search"></view>
    <view class="sw-skeleton sk-card"></view>
    <view class="sw-skeleton sk-entries"></view>
    <view class="sw-skeleton sk-hero"></view>
  </view>

  <block wx:else>
    <!-- 2. 当前企业与福利计划 ---------------------------------------------- -->
    <view class="sw-inset">
      <view class="scope-chip">
        <view class="scope-mark sw-brand-mark"></view>
        <text class="scope-text">{{scope.enterpriseName}} · {{scope.departmentName}}</text>
      </view>
    </view>

    <!-- 3. 公开商品搜索 ------------------------------------------------------ -->
    <view class="sw-inset search-wrap">
      <view class="search sw-tap" bindtap="onOpenSearch">
        <view class="i i-sm i-search-muted"></view>
        <text class="search-placeholder">搜索商品或品牌</text>
      </view>
    </view>

    <!-- 4. 福利额度与手机认证状态 -------------------------------------------- -->
    <view class="sw-inset">
      <view class="sw-card quota sw-tap" bindtap="onOpenProfile">
        <view class="sw-between">
          <view>
            <text class="sw-caption quota-label">{{quotaLabel}}</text>
            <view class="quota-value">
              <block wx:if="{{quotaAmount}}">
                <text class="quota-symbol">¥</text>
                <text class="sw-amount">{{quotaAmount}}</text>
              </block>
              <text wx:else class="quota-pending">{{quotaPendingText}}</text>
            </view>
          </view>
          <view class="i i-chevron-right-muted"></view>
        </view>
        <view wx:if="{{identityNotice}}" class="phone-notice notice-{{identityNoticeTone}}">
          <view class="i i-sm {{identityNoticeTone === 'danger' ? 'i-shield-alert-danger' : 'i-lock-muted'}}"></view>
          <text class="phone-notice-text">{{identityNotice}}</text>
        </view>
      </view>
    </view>

    <!-- 4. 已接通公开目录的四个快捷分类 ------------------------------------- -->
    <view class="sw-inset segment-grid">
      <view
        wx:for="{{segments}}"
        wx:key="key"
        class="sw-card segment sw-tap"
        data-item="{{item}}"
        bindtap="onOpenSegment"
      >
        <view class="segment-text">
          <text class="segment-title">{{item.title}}</text>
          <text class="segment-desc">{{item.desc}}</text>
        </view>
        <image wx:if="{{item.image}}" class="segment-image" src="{{item.image}}" mode="aspectFill" lazy-load fade-in="{{false}}" />
        <view wx:else class="segment-mark">
          <view class="i i-{{item.icon}}-brand"></view>
        </view>
      </view>
    </view>

    <!-- 8. 到店出示会员码 ---------------------------------------------------- -->
    <view class="sw-inset">
      <view class="membercode-cta sw-tap" bindtap="onOpenMemberCode">
        <view class="membercode-cta-mark sw-membercode-mark"></view>
        <view class="membercode-cta-text">
          <text class="membercode-cta-title">{{memberCodeCta.title}}</text>
          <text class="membercode-cta-desc">{{memberCodeCta.desc}}</text>
        </view>
        <view class="i i-chevron-right-muted"></view>
      </view>
    </view>

    <!-- 6. 真实公开商品推荐 -------------------------------------------------- -->
    <view class="section-head sw-inset">
      <text class="sw-h3">公开商品推荐</text>
      <text class="section-more sw-tap" bindtap="onOpenAllProducts">查看全部</text>
    </view>
    <view wx:if="{{recommendations.length}}" class="sw-inset product-grid">
      <view
        wx:for="{{recommendations}}"
        wx:key="id"
        class="sw-card product sw-tap"
        data-index="{{index}}"
        bindtap="onOpenRecommendation"
      >
        <image wx:if="{{item.image}}" class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load fade-in="{{false}}" data-index="{{index}}" binderror="onRecommendationImageError" />
        <view wx:else class="sw-slot product-slot">
          <view class="i i-md i-image-off-muted"></view>
        </view>
        <view class="product-body">
          <text class="product-title">{{item.title}}</text>
          <view class="product-tag">{{item.tag}}</view>
          <view class="product-price">
            <block wx:if="{{item.price}}">
              <text class="product-price-symbol">¥</text>
              <text class="product-price-value">{{item.price}}</text>
              <text wx:if="{{item.marketPrice}}" class="product-market">¥{{item.marketPrice}}</text>
            </block>
            <text wx:else class="product-price-pending">价格待同步</text>
          </view>
          <text class="product-source">来源：{{item.source}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="sw-inset state-block">
      <view class="i i-lg i-inbox-muted"></view>
      <text class="sw-small state-text">当前没有可展示的公开商品</text>
    </view>
  </block>

  <!-- 底栏与底部安全区留白 -->
  <view class="tabbar-spacer"></view>
</view>
