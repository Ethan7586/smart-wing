/* Home commerce sections loaded by home.wxss. */
.entries {
  display: flex;
  align-items: stretch;
  margin-top: var(--sw-space-2);
  padding: var(--sw-space-1_5) 0;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--sw-radius-medium);
  background: var(--sw-brand-light);
}
.entry-label {
  margin-top: 10rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text);
}

.hero {
  position: relative;
  overflow: hidden;
  margin-top: var(--sw-space-2);
  padding: var(--sw-space-2);
  min-height: 200rpx;
  box-sizing: border-box;
  border-radius: var(--sw-radius-large);
  background: var(--sw-brand-gradient);
}
.hero-pattern {
  position: absolute;
  right: -40rpx;
  bottom: -30rpx;
  width: 240rpx;
  height: 240rpx;
  opacity: 0.18;
  background-size: contain;
  background-position: right bottom;
}
.hero-copy {
  position: relative;
  z-index: 1;
}
.hero-title {
  display: block;
  font-size: var(--sw-fs-h2);
  line-height: var(--sw-lh-h2);
  font-weight: var(--sw-fw-h2);
  color: var(--sw-text-inverse);
}
.hero-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  color: var(--sw-inverse-strong);
}
.hero-slot,
.hero-illustration {
  position: absolute;
  right: var(--sw-space-2);
  top: 50%;
  margin-top: -60rpx;
  width: 180rpx;
  height: 120rpx;
}
.hero-dots {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-top: var(--sw-space-1_5);
}
.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%; /* vi-allow: css-drawn-icon — 轮播指示点，不是图标 */
  background: var(--sw-inverse-muted);
}
.dot-on {
  width: 24rpx;
  border-radius: 5rpx;
  background: var(--sw-text-inverse);
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: var(--sw-space-3);
  margin-bottom: var(--sw-space-1_5);
}

.partner-scroll {
  width: 100%;
  white-space: nowrap;
}
.partner-row {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  padding-left: var(--sw-page-inset);
  padding-right: var(--sw-page-inset);
}
/* Width derives from how many should be visible at once. A fractional value
   leaves a peeking item that signals the row scrolls. */
.partner {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(100% / var(--sw-partner-visible) - 16rpx);
  margin-right: var(--sw-space-1);
  flex-shrink: 0;
}
.partner-logo,
.partner-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--sw-radius-medium);
  background: var(--sw-surface);
  border: 1rpx solid var(--sw-border);
  box-sizing: border-box;
}
.partner-label {
  margin-top: 10rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-secondary);
}

.segment-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: var(--sw-space-2);
}
.segment {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(50% - 8rpx);
  margin-bottom: var(--sw-space-1);
  padding: var(--sw-space-1_5);
}
.segment-text {
  flex: 1;
  min-width: 0;
}
.segment-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: 600;
  color: var(--sw-text);
}
.segment-desc {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-muted);
}
.segment-image,
.segment-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  border-radius: var(--sw-radius-small);
  background: var(--sw-brand-light);
  flex-shrink: 0;
}

.membercode-cta {
  display: flex;
  align-items: center;
  margin-top: var(--sw-space-1);
  padding: var(--sw-space-1_5);
  border-radius: var(--sw-radius-large);
  background: var(--sw-brand-light);
}
.membercode-cta-mark {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}
.membercode-cta-text {
  flex: 1;
  min-width: 0;
  margin-left: var(--sw-space-1_5);
}
.membercode-cta-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: 600;
  color: var(--sw-brand-dark);
}
.membercode-cta-desc {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-secondary);
}

/* space-between spreads a partial last row to both edges — visible as soon as
   the large size class switches to three columns. A negative container margin
   carries a fixed gutter instead, and works for any column count. */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
}
/* Column count comes from the size class; the 16rpx gutter is shared. */
.product {
  width: calc((100% - (var(--sw-product-columns) - 1) * 16rpx) / var(--sw-product-columns));
  margin-right: 16rpx;
  margin-bottom: var(--sw-space-1);
  overflow: hidden;
}
.product-image,
.product-slot {
  width: 100%;
  height: 240rpx;
  border: 0;
  border-bottom: 1rpx solid var(--sw-border);
  border-radius: 0;
}
.product-body {
  padding: var(--sw-space-1);
}
/* Two lines reserved whether the title needs them or not, so the tag, price
   and source rows stay on the same baseline across a row of cards. */
.product-title {
  font-size: var(--sw-fs-bodySmall);
  line-height: 36rpx;
  height: 72rpx;
  color: var(--sw-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.product-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 8rpx;
  height: 32rpx;
  border-radius: var(--sw-radius-small);
  background: var(--sw-brand-light);
  color: var(--sw-brand-dark);
  font-size: 20rpx;
  line-height: 32rpx;
}
.product-price {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.product-price-symbol {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-caption);
  font-weight: 700;
  color: var(--sw-danger);
}
.product-price-value {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-h3);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--sw-danger);
}
.product-market {
  margin-left: 8rpx;
  font-family: var(--sw-font-num);
  font-size: 20rpx;
  color: var(--sw-text-disabled);
  text-decoration: line-through;
}
.product-source {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-muted);
}
.tabbar-spacer {
  height: calc(var(--sw-tabbar-height) + var(--sw-space-2) + env(safe-area-inset-bottom, 0px));
}
