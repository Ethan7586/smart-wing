/* Home commerce sections loaded by home.wxss. Kept separate from the top-shell
   styling so both files stay within the repository line budget. */

.partner-scroll { width: 100%; white-space: nowrap; }
.partner-row {
  display: flex;
  align-items: flex-start;
  padding-left: var(--sw-page-inset);
  padding-right: var(--sw-page-inset);
}
.partner {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  margin-right: var(--sw-space-1);
  flex-shrink: 0;
}
.partner-logo,
.partner-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--sw-radius-medium);
  background: var(--sw-surface);
  border: 1rpx solid var(--sw-border);
  box-sizing: border-box;
}
.partner-label {
  margin-top: 10rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-secondary);
}

.segment-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: var(--sw-space-2);
}
.segment {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(50% - 8rpx);
  margin-bottom: var(--sw-space-1);
  padding: var(--sw-space-1_5);
}
.segment-text { flex: 1; min-width: 0; }
.segment-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: 600;
  color: var(--sw-text);
}
.segment-desc {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-muted);
}
.segment-image,
.segment-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  border-radius: var(--sw-radius-small);
  background: var(--sw-brand-light);
  flex-shrink: 0;
}

.membercode-cta {
  display: flex;
  align-items: center;
  margin-top: var(--sw-space-1);
  padding: var(--sw-space-1_5);
  border-radius: var(--sw-radius-large);
  background: var(--sw-brand-light);
}
.membercode-cta-mark { width: 64rpx; height: 64rpx; flex-shrink: 0; }
.membercode-cta-text {
  flex: 1;
  min-width: 0;
  margin-left: var(--sw-space-1_5);
}
.membercode-cta-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: 600;
  color: var(--sw-brand-dark);
}
.membercode-cta-desc {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-secondary);
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product {
  width: calc(50% - 8rpx);
  margin-bottom: var(--sw-space-1);
  overflow: hidden;
}
.product-image,
.product-slot {
  width: 100%;
  height: 240rpx;
  border: 0;
  border-bottom: 1rpx solid var(--sw-border);
  border-radius: 0;
}
.product-body { padding: var(--sw-space-1); }
.product-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: 36rpx;
  color: var(--sw-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.product-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 8rpx;
  height: 32rpx;
  border-radius: var(--sw-radius-small);
  background: var(--sw-brand-light);
  color: var(--sw-brand-dark);
  font-size: 20rpx;
  line-height: 32rpx;
}
.product-price { display: flex; align-items: baseline; margin-top: 8rpx; }
.product-price-symbol {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-caption);
  font-weight: 700;
  color: var(--sw-danger);
}
.product-price-value {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-h3);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--sw-danger);
}
.product-market {
  margin-left: 8rpx;
  font-family: var(--sw-font-num);
  font-size: 20rpx;
  color: var(--sw-text-disabled);
  text-decoration: line-through;
}
.product-source {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--sw-text-muted);
}
.tabbar-spacer {
  height: calc(108rpx + var(--sw-space-2) + env(safe-area-inset-bottom, 0px));
}
