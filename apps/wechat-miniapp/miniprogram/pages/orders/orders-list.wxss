.order-list {
  padding-top: var(--sw-space-2);
}

.order-card {
  margin-bottom: var(--sw-space-2);
  padding: var(--sw-space-2);
}

.order-head,
.source-row,
.item-row,
.order-foot,
.amount-row {
  display: flex;
  align-items: center;
}

.order-head,
.order-foot {
  justify-content: space-between;
}

.source-row {
  min-width: 0;
  flex: 1;
}

.source-mark {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.source-name {
  margin-left: var(--sw-space-half);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: var(--sw-fw-h3);
  color: var(--sw-text);
}

.status {
  margin-left: var(--sw-space-1);
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
}

.status-warning {
  color: var(--sw-warning-strong);
}

.status-brand {
  color: var(--sw-brand);
}

.status-success {
  color: var(--sw-success-strong);
}

.status-muted {
  color: var(--sw-text-muted);
}

.item-row {
  margin-top: var(--sw-space-1_5);
  padding: var(--sw-space-1);
  background: var(--sw-surface-subtle);
  border-radius: var(--sw-radius-medium);
}

.item-image,
.item-slot {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--sw-radius-small);
}

.item-image {
  background: var(--sw-surface);
}

.item-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--sw-border-strong);
  background: var(--sw-surface);
  box-sizing: border-box;
}

.item-copy {
  min-width: 0;
  flex: 1;
  margin-left: var(--sw-space-1_5);
}

.item-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  color: var(--sw-text);
}

.item-summary,
.order-time {
  display: block;
  margin-top: 4rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-muted);
}

.item-quantity {
  align-self: flex-start;
  margin-left: var(--sw-space-1);
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-caption);
  color: var(--sw-text-secondary);
}

.order-note {
  margin-top: var(--sw-space-1_5);
  padding-bottom: var(--sw-space-1_5);
  border-bottom: 1rpx solid var(--sw-border);
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-muted);
}

.order-foot {
  margin-top: var(--sw-space-1_5);
}

.amount-label {
  margin-right: var(--sw-space-half);
  font-size: var(--sw-fs-caption);
  color: var(--sw-text-muted);
}

.amount-symbol,
.amount-value {
  font-family: var(--sw-font-num);
  font-variant-numeric: tabular-nums;
  color: var(--sw-text);
}

.amount-pending {
  font-size: var(--sw-fs-bodySmall);
  color: var(--sw-text-muted);
}

.amount-symbol {
  font-size: var(--sw-fs-caption);
}

.amount-value {
  font-size: var(--sw-fs-h3);
  font-weight: var(--sw-fw-h3);
}

.order-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 152rpx;
  padding: 0 var(--sw-space-1_5);
  border: 1rpx solid var(--sw-border-strong);
  border-radius: var(--sw-radius-medium);
  color: var(--sw-text-secondary);
  font-size: var(--sw-fs-bodySmall);
  box-sizing: border-box;
}

.order-action.is-primary {
  border-color: var(--sw-brand);
  background: var(--sw-brand);
  color: var(--sw-text-inverse);
}

.tabbar-spacer {
  height: calc(var(--sw-tabbar-height) + var(--sw-space-2) + env(safe-area-inset-bottom, 0px));
}
