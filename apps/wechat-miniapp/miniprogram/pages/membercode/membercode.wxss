@import './membercode-rows.wxss';

/* Widths come from generated size-class tokens; calc() never divides by a
   var(); spacing uses margins because flex gap is unreliable on older
   WeChat Android base libraries. */

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--sw-background);
}

.nav-row {
  display: flex;
  align-items: center;
  padding-left: var(--sw-page-inset);
  padding-right: var(--sw-page-inset);
  box-sizing: border-box;
}

.nav-title {
  display: block;
  flex-shrink: 0;
  white-space: nowrap;
  font-size: var(--sw-fs-h2);
  line-height: var(--sw-lh-h2);
  font-weight: var(--sw-fw-h2);
  color: var(--sw-text);
}

/* ------------------------------------------------------------ states ------ */

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: var(--sw-space-6);
}

.state-text {
  margin-top: var(--sw-space-1);
  text-align: center;
}

.retry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sw-space-2);
  padding: 0 var(--sw-space-2);
  height: var(--sw-touch-min);
  border: 1rpx solid var(--sw-brand);
  border-radius: var(--sw-radius-medium);
}

.retry-text {
  margin-left: 8rpx;
  font-size: var(--sw-fs-bodySmall);
  color: var(--sw-brand);
}

.skeleton-wrap {
  padding-top: var(--sw-space-2);
}
.sk-card {
  height: 260rpx;
  margin-bottom: var(--sw-space-2);
}
.sk-code {
  height: 560rpx;
}

/* -------------------------------------------------- digital member card ---- */

.card {
  position: relative;
  overflow: hidden;
  margin-top: var(--sw-space-1);
  padding: var(--sw-space-2);
  border-radius: var(--sw-radius-extraLarge);
  background: var(--sw-brand-gradient);
  box-shadow: var(--sw-shadow-membercode);
}

/* Official wing pattern, not an invented decoration. */
.card-pattern {
  position: absolute;
  right: -30rpx;
  bottom: -40rpx;
  width: 260rpx;
  height: 260rpx;
  opacity: 0.16;
  background-size: contain;
  background-position: right bottom;
}

.card-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
}

.card-name {
  font-size: var(--sw-fs-h2);
  line-height: var(--sw-lh-h2);
  font-weight: var(--sw-fw-h2);
  color: var(--sw-text-inverse);
}

.card-level {
  margin-left: var(--sw-space-1);
  padding: 0 10rpx;
  border-radius: var(--sw-radius-small);
  background: var(--sw-inverse-faint);
  font-size: var(--sw-fs-caption);
  line-height: 32rpx;
  color: var(--sw-text-inverse);
}

.card-org {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 6rpx;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  color: var(--sw-inverse-strong);
}

.card-foot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sw-space-2);
}

.card-no {
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-caption);
  letter-spacing: 2rpx;
  color: var(--sw-inverse-strong);
}

.card-verify {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  height: 40rpx;
  border-radius: var(--sw-radius-full);
  background: var(--sw-inverse-faint);
}

.card-verify-text {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: var(--sw-text-inverse);
}

/* -------------------------------------------------------- status band ------ */

.status {
  display: flex;
  align-items: flex-start;
  margin-top: var(--sw-space-2);
  padding: var(--sw-space-1_5);
  border-radius: var(--sw-radius-large);
  border: 1rpx solid var(--sw-border);
  background: var(--sw-surface);
}

.status-ok {
  background: var(--sw-success-surface);
  border-color: var(--sw-success-surface);
}
.status-warn {
  background: var(--sw-warning-surface);
  border-color: var(--sw-warning-surface);
}
.status-danger {
  background: var(--sw-danger-surface);
  border-color: var(--sw-danger-surface);
}

.status-text {
  margin-left: 12rpx;
  flex: 1;
  min-width: 0;
}

.status-title {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  font-weight: 600;
  color: var(--sw-text);
}

.status-desc {
  display: block;
  margin-top: 2rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-secondary);
}

/* --------------------------------------------------------- code card ------- */

.code-card {
  margin-top: var(--sw-space-2);
  padding: var(--sw-space-2);
  border-radius: var(--sw-radius-large);
  background: var(--sw-surface);
  border: 1rpx solid var(--sw-border);
}

.qr-frame,
.qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 380rpx;
  border-radius: var(--sw-radius-medium);
  background: var(--sw-surface-subtle);
  border: 1rpx solid var(--sw-border);
}

.qr-canvas {
  width: 340rpx;
  height: 340rpx;
  background: var(--sw-surface);
}

.qr-status-title {
  margin-top: var(--sw-space-1);
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  color: var(--sw-text-secondary);
}

.qr-status-desc {
  margin-top: 4rpx;
  font-size: var(--sw-fs-caption);
  line-height: var(--sw-lh-caption);
  color: var(--sw-text-muted);
}

.countdown {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--sw-space-1_5);
}

.countdown-text {
  margin-left: 8rpx;
  font-family: var(--sw-font-num);
  font-size: var(--sw-fs-bodySmall);
  color: var(--sw-text-secondary);
}

.warn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.warn-text {
  margin-left: 8rpx;
  font-size: var(--sw-fs-caption);
  color: var(--sw-text-muted);
}
