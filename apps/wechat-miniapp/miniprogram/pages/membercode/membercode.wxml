<!--
  会员码 — 构图对照
  docs/mobile/design-previews/smart-wing-member-card-code-v2.png
  与 smart-wing-unified-mall-01-browse-v2-cart-restored.png 第 3 屏。

  会员码不是支付码。码内不写姓名、手机号、企业名、余额与消费记录 ——
  只承载短期挑战凭证，见 docs/mobile/WING-CODE-WECHAT-MINIAPP-MASTER-PLAN.md §6。
-->
<view class="sw-page membercode {{sizeClass}}" style="{{sizeStyle}}">

  <view class="nav" style="padding-top: {{nav.statusBarHeight}}px;">
    <view class="nav-row" style="height: {{nav.navContentHeight}}px;">
      <text class="nav-title">会员码</text>
    </view>
  </view>
  <view style="height: {{nav.navTotalHeight}}px;"></view>

  <view wx:if="{{loadError}}" class="sw-inset state-block">
    <view class="i i-lg i-wifi-off-muted"></view>
    <text class="sw-small state-text">{{loadError}}</text>
    <view class="retry" bindtap="onRetry">
      <view class="i i-sm i-refresh-cw-brand"></view>
      <text class="retry-text">重试</text>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="sw-inset skeleton-wrap">
    <view class="sw-skeleton sk-card"></view>
    <view class="sw-skeleton sk-code"></view>
  </view>

  <block wx:else>
    <!-- 数字会员卡 -->
    <view class="sw-inset">
      <view class="card">
        <view class="card-pattern sw-brand-pattern"></view>
        <view class="card-head">
          <text class="card-name">{{card.memberName || '未登录会员'}}</text>
          <text class="card-level">{{card.level || '待认证'}}</text>
        </view>
        <text class="card-org">{{card.enterpriseName || '登录后显示所属企业'}}</text>
        <view class="card-foot">
          <text class="card-no">会员编号 {{card.maskedNo || '****  ****  ****'}}</text>
          <view class="card-verify {{card.phoneVerified ? 'is-ok' : 'is-warn'}}">
            <view class="i i-sm {{card.phoneVerified ? 'i-shield-check-success' : 'i-shield-alert-danger'}}"></view>
            <text class="card-verify-text">{{card.phoneVerified ? '手机已认证' : '手机未认证'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 安全状态：图标 + 文字 + 颜色三者齐全 -->
    <view class="sw-inset">
      <view class="status status-{{state.tone}}">
        <view class="i i-sm {{state.icon}}"></view>
        <view class="status-text">
          <text class="status-title">{{state.title}}</text>
          <text class="status-desc">{{state.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 动态会员码 -->
    <view class="sw-inset">
      <view class="code-card">
        <view wx:if="{{simulated}}" class="sim-flag">
          <view class="i i-sm i-triangle-alert-danger"></view>
          <text>模拟码 · 服务端挑战凭证接口尚未接通，不可用于真实核验</text>
        </view>

        <view class="qr">
          <view class="i i-xl i-qr-code-brand"></view>
          <text class="qr-note">{{challenge ? challenge : '等待服务端签发'}}</text>
        </view>

        <view class="bar">
          <view class="i i-barcode-ink bar-icon"></view>
        </view>

        <view class="countdown">
          <view class="i i-sm i-clock-muted"></view>
          <text class="countdown-text">{{seconds}} 秒后自动刷新</text>
        </view>

        <view class="warn">
          <view class="i i-sm i-eye-off-muted"></view>
          <text class="warn-text">请勿截图转发 · 会员码不是支付码</text>
        </view>

        <view class="actions">
          <view class="act sw-tap" bindtap="onRefresh">
            <view class="i i-sm i-rotate-cw-brand"></view>
            <text class="act-text">刷新会员码</text>
          </view>
          <view class="act sw-tap" bindtap="onBrighten">
            <view class="i i-sm i-sun-brand"></view>
            <text class="act-text">调亮屏幕</text>
          </view>
          <view class="act sw-tap" data-label="冻结会员码" bindtap="onPending">
            <view class="i i-sm i-snowflake-danger"></view>
            <text class="act-text act-danger">冻结</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 核验记录与客服 -->
    <view class="sw-inset">
      <view class="sw-card row-link sw-tap" data-label="核验记录" bindtap="onPending">
        <view class="i i-file-text-brand"></view>
        <text class="row-text">核验记录</text>
        <view class="i i-chevron-right-muted"></view>
      </view>
      <view class="sw-card row-link sw-tap" data-label="联系客服" bindtap="onPending">
        <view class="i i-headphones-brand"></view>
        <text class="row-text">联系客服</text>
        <view class="i i-chevron-right-muted"></view>
      </view>
    </view>
  </block>

  <view class="tabbar-spacer"></view>
</view>
