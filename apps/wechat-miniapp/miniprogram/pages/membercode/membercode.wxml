<view class="sw-page membercode {{sizeClass}}" style="{{sizeStyle}}">
  <view class="nav" style="padding-top: {{nav.statusBarHeight}}px;">
    <view class="nav-row" style="height: {{nav.navContentHeight}}px; padding-right: {{nav.rightInset}}px;">
      <text class="nav-title">会员码</text>
    </view>
  </view>
  <view style="height: {{nav.navTotalHeight}}px;"></view>

  <view wx:if="{{loadError}}" class="sw-inset state-block">
    <view class="i i-lg i-wifi-off-muted"></view>
    <text class="sw-small state-text">{{loadError}}</text>
    <view class="retry sw-tap" bindtap="onRetry">
      <view class="i i-sm i-refresh-cw-brand"></view>
      <text class="retry-text">重试</text>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="sw-inset skeleton-wrap">
    <view class="sw-skeleton sk-card"></view>
    <view class="sw-skeleton sk-code"></view>
  </view>

  <view wx:elif="{{!signedIn}}" class="sw-inset access-card">
    <view class="access-mark sw-membercode-mark"></view>
    <text class="sw-h2 access-title">登录后使用会员码</text>
    <text class="sw-small access-desc">微信登录用于确认会员身份；未登录不会生成或展示任何会员凭证。</text>
    <view class="primary-action sw-tap" bindtap="onOpenAuth">登录或注册</view>
  </view>

  <block wx:else>
    <view class="sw-inset">
      <view class="card">
        <view class="card-pattern sw-brand-pattern"></view>
        <view class="card-head">
          <text class="card-name">{{card.memberName}}</text>
          <text class="card-level">{{card.level || '会员'}}</text>
        </view>
        <text class="card-org">{{card.enterpriseName || '企业信息待同步'}}</text>
        <view class="card-foot">
          <text class="card-no">会员编号 {{card.maskedNo}}</text>
          <view class="card-verify {{card.phoneVerified ? 'is-ok' : 'is-warn'}}">
            <view class="i i-sm {{card.phoneVerified ? 'i-shield-check-success' : 'i-shield-alert-danger'}}"></view>
            <text class="card-verify-text">{{card.phoneVerified ? '手机已认证' : '手机未认证'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="sw-inset">
      <view class="status status-{{state.tone}}">
        <view class="i i-sm {{state.icon}}"></view>
        <view class="status-text">
          <text class="status-title">{{state.title}}</text>
          <text class="status-desc">{{state.desc}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!card.phoneVerified}}" class="sw-inset">
      <view class="verification-card">
        <view class="i i-lg i-shield-alert-danger"></view>
        <text class="sw-h3 verification-title">完成手机认证</text>
        <text class="sw-small verification-desc">认证成功后，系统才允许申请短期、可撤销的门店核验凭证。</text>
        <view class="primary-action sw-tap" bindtap="onVerifyPhone">去认证手机号</view>
      </view>
    </view>

    <view wx:else class="sw-inset">
      <view class="verification-card">
        <view class="i i-lg i-shield-check-success"></view>
        <text class="sw-h3 verification-title">安全保护已启用</text>
        <text class="sw-small verification-desc">门店凭证仅可由服务端实时签发，过期后自动失效。</text>
      </view>
    </view>

    <view class="sw-inset">
      <button plain class="sw-card row-link contact-button" open-type="contact">
        <view class="i i-headphones-brand"></view>
        <text class="row-text">联系平台客服</text>
        <view class="i i-chevron-right-muted"></view>
      </button>
    </view>
  </block>

  <view class="tabbar-spacer"></view>
</view>
