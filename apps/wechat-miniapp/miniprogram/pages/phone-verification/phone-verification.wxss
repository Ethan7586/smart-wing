.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--sw-background);
}
.nav-row,
.back,
.assurance-head,
.assurance-icon,
.code-row,
.code-button,
.submit {
  display: flex;
  align-items: center;
}
.nav-row {
  padding-left: var(--sw-page-inset);
}
.back,
.assurance-icon,
.code-button,
.submit {
  justify-content: center;
}
.back {
  width: var(--sw-touch-min);
  height: var(--sw-touch-min);
  margin-left: calc(0rpx - var(--sw-space-1));
}
.nav-title {
  margin-left: var(--sw-space-1);
  font-size: var(--sw-fs-h3);
  line-height: var(--sw-lh-h3);
  font-weight: var(--sw-fw-h3);
  color: var(--sw-text);
}
.phone-body {
  padding-top: var(--sw-space-2);
  padding-bottom: var(--sw-space-6);
}
.assurance-head {
  flex-direction: column;
  text-align: center;
}
.assurance-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: var(--sw-space-1_5);
  border-radius: var(--sw-radius-full);
  background: var(--sw-success-surface);
}
.assurance-note {
  max-width: 600rpx;
  margin-top: var(--sw-space-1);
  font-size: var(--sw-fs-bodySmall);
  line-height: var(--sw-lh-bodySmall);
  color: var(--sw-text-secondary);
}
.form {
  margin-top: var(--sw-space-3);
  padding: var(--sw-space-2);
}
.field-label {
  display: block;
  font-size: var(--sw-fs-bodySmall);
  font-weight: 600;
  color: var(--sw-text);
}
.field-next {
  margin-top: var(--sw-space-2);
}
.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--sw-touch-min);
  margin-top: 8rpx;
  padding: 0 var(--sw-space-1_5);
  border: 1rpx solid var(--sw-border);
  border-radius: var(--sw-radius-medium);
  background: var(--sw-background);
  font-size: var(--sw-fs-bodySmall);
  color: var(--sw-text);
}
.code-row {
  margin-top: 8rpx;
}
.mobile-input {
  min-width: 0;
  margin-top: 0;
}
.code-button {
  flex-shrink: 0;
  min-width: 200rpx;
  min-height: var(--sw-touch-min);
  margin-left: var(--sw-space-1);
  border: 1rpx solid var(--sw-brand);
  border-radius: var(--sw-radius-medium);
  font-size: var(--sw-fs-caption);
  color: var(--sw-brand);
}
.form-error {
  display: block;
  margin-top: var(--sw-space-1_5);
  font-size: var(--sw-fs-caption);
  color: var(--sw-danger);
}
.submit {
  min-height: var(--sw-touch-min);
  margin-top: var(--sw-space-2);
  border-radius: var(--sw-radius-medium);
  background: var(--sw-brand);
  font-size: var(--sw-fs-bodySmall);
  font-weight: 600;
  color: var(--sw-text-inverse);
}
.is-disabled {
  opacity: 0.5;
}
