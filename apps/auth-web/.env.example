# Auth UI only. It must never contain database, service-role, or signing secrets.
# During local development, API calls should use the commerce API via the same origin.
VITE_AUTH_API_BASE_URL="/api"

# Production must use "api". A developer may set "mock" only in an untracked
# .env.local to exercise the UI before the real authentication API is ready.
VITE_AUTH_MODE="api"
