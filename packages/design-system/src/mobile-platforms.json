  },

  "sizeClassPrinciple": "布局跟随屏幕比例缩放，文字保持物理尺寸大致恒定。rpx 会把两者一起缩放，所以文字需要按档位反向补偿。四档同时成立，都是正式移动端 VI，不是主次关系。",

  "sizeClasses": [
    {
      "key": "compact",
      "label": "紧凑",
      "minWidthPt": 0,
      "maxWidthPt": 344,
      "referenceWidthPt": 320,
      "devices": "iPhone SE 一代 / 5s、小屏安卓、分屏窗口",
      "textScale": 1.12,
      "pageHorizontalInset": 24,
      "productColumns": 2,
      "segmentColumns": 2,
      "partnerVisible": 4.5,
      "navTitleStyle": "h3",
      "note": "文字放大 12% 补偿窄屏；边距收窄让出内容宽度；标题降一级避免与胶囊抢位。"
    },
    {
      "key": "standard",
      "label": "标准",
      "minWidthPt": 345,
      "maxWidthPt": 392,
      "referenceWidthPt": 375,
      "devices": "iPhone SE2/SE3、13 mini、多数安卓",
      "textScale": 1.0,
      "pageHorizontalInset": 32,
      "productColumns": 2,
      "segmentColumns": 2,
      "partnerVisible": 5,
      "navTitleStyle": "h2",
      "note": "设计基线。750rpx = 375pt，所有令牌的原始换算档位。"
    },
    {
      "key": "regular",
      "label": "常规",
      "minWidthPt": 393,
      "maxWidthPt": 428,
      "referenceWidthPt": 410,
      "devices": "iPhone 14/15/16、主流大屏安卓",
      "textScale": 0.94,
      "pageHorizontalInset": 32,
      "productColumns": 2,
      "segmentColumns": 2,
      "partnerVisible": 5.5,
      "navTitleStyle": "h2",
      "note": "文字缩 6%，抵消 rpx 在宽屏上的放大，同时多容纳内容。"
    },
    {
      "key": "large",
      "label": "宽屏",
      "minWidthPt": 429,
      "maxWidthPt": null,
      "referenceWidthPt": 440,
      "devices": "Pro Max、大屏安卓、折叠机内屏",
      "textScale": 0.9,
      "pageHorizontalInset": 40,
      "productColumns": 3,
      "segmentColumns": 2,
      "partnerVisible": 6.5,
      "navTitleStyle": "h2",
      "note": "边距加宽避免内容摊平；推荐位改三列利用横向空间；文字缩 10% 保持物理尺寸。"
    }
  ],

  "overflowRules": [
    {
      "key": "no-horizontal-scroll",
      "rule": "页面本身禁止横向滚动。任何横向内容必须自带 scroll-view，不得靠页面溢出实现。"
    },
    {
      "key": "amount-never-truncates",
      "rule": "金额永不换行、永不省略、永不缩小字号。空间不足时由相邻元素让位。"
    },
    {
      "key": "product-title-two-lines",
      "rule": "商品标题固定预留两行并夹断，无论实际是一行还是三行 —— 同一行卡片的价格与来源必须落在同一基线。"
    },
    {
      "key": "single-line-clamp",
      "rule": "分区描述、来源、企业名等辅助文字单行夹断。企业名与部门名同时超长时，先省略部门名，保留企业名。"
    },
    {
      "key": "badge-cap",
      "rule": "角标数字大于 99 显示「99+」，不得撑宽角标。"
    },
    {
      "key": "nav-title-single-line",
      "rule": "顶部标题必须单行且不截断。空间不足由 navTitleStyle 降级解决，不得省略号，不得隐藏购物车。"
    },
    {
      "key": "touch-target-floor",
      "rule": "任何可点区域的最小边不低于 minimumTouchTarget，档位变化不得突破这条下限。"
    }
  ]
}
