{
  "name": "smart-wing-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "build:miniapp-assets": "node scripts/build-miniapp-assets.mjs",
    "build:miniapp-catalog-seed": "node scripts/build-miniapp-catalog-seed.mjs",
    "sync:catalog-media": "node scripts/sync-catalog-media-to-oss.mjs",
    "publish:catalog-manifest": "node --env-file-if-exists=.env.production scripts/publish-catalog-manifest-to-oss.mjs",
    "test:catalog-media-cache": "node --test scripts/catalog-media-cache.test.mjs",
    "test:catalog-manifest": "node --test scripts/catalog-manifest.test.mjs",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "test:backup": "node --test scripts/postgres-backup.test.mjs",
    "check:miniapp": "node scripts/check-miniapp-vi.mjs",
    "check:vi": "node scripts/check-vi.mjs --check",
    "update:vi-baseline": "node scripts/check-vi.mjs --update-baseline",
    "test:vi": "node --test scripts/check-vi.test.mjs",
    "test:token-convergence": "node --test scripts/token-convergence.test.mjs",
    "test:miniapp-catalog": "node --test scripts/miniapp-catalog.test.cjs",
    "test:miniapp-performance": "node --test scripts/miniapp-performance.test.cjs",
    "test:miniapp-account": "node --test scripts/miniapp-account-presentation.test.cjs",
    "test:miniapp-share": "node --test scripts/miniapp-share.test.cjs",
    "test:miniapp-checkout": "node --test scripts/miniapp-checkout.test.cjs",
    "dev:storefront": "npm run dev --workspace @smart-wing/storefront-web",
    "dev:admin": "npm run dev --workspace @smart-wing/admin-web",
    "dev:auth": "npm run dev --workspace @smart-wing/auth-web",
    "build:storefront": "npm run build --workspace @smart-wing/storefront-web",
    "build:admin": "npm run build --workspace @smart-wing/admin-web",
    "build:auth": "npm run build --workspace @smart-wing/auth-web",
    "build:commerce-api": "esbuild services/commerce-api/src/adminServer.ts --bundle --platform=node --format=cjs --external:@google/genai --external:dotenv --external:express --sourcemap --outfile=services/commerce-api/dist/admin-server.cjs",
    "build:core-read-cache": "esbuild services/core-read-cache/src/server.ts --bundle --platform=node --format=esm --external:redis --sourcemap --outfile=services/core-read-cache/dist/server.mjs",
    "build": "npm run build:storefront && npm run build:admin && npm run build:auth && npm run build:commerce-api && npm run build:core-read-cache",
    "start:storefront": "npm run start --workspace @smart-wing/storefront-web",
    "start:admin-api": "node services/commerce-api/dist/admin-server.cjs",
    "format": "prettier --write --ignore-unknown .",
    "check:format": "prettier --check --ignore-unknown .",
    "lint": "npm run lint --workspace @smart-wing/storefront-web && npm run lint --workspace @smart-wing/admin-web && npm run lint --workspace @smart-wing/auth-web && npm run lint --workspace @smart-wing/commerce-api && npm run lint --workspace @smart-wing/core-read-cache",
    "test": "npm run test --workspace @smart-wing/storefront-web && npm run test --workspace @smart-wing/commerce-api && npm run test --workspace @smart-wing/core-read-cache",
    "audit:prod": "npm audit --omit=dev",
    "check:lines": "node scripts/check-line-budget.mjs",
    "verify:p0": "node scripts/verify-p0.mjs",
    "quality": "npm run check:format && npm run check:lines && npm run check:web-tokens && npm run test:token-convergence && npm run check:vi && npm run test:vi && npm run check:miniapp && npm run test:miniapp-catalog && npm run test:miniapp-performance && npm run test:miniapp-account && npm run test:miniapp-share && npm run test:miniapp-checkout && npm run test:catalog-media-cache && npm run test:catalog-manifest && npm run test:backup && npm run lint && npm test && npm run build && npm run audit:prod",
    "build:web-tokens": "node scripts/build-web-tokens.mjs",
    "check:web-tokens": "node scripts/build-web-tokens.mjs --check"
  },
  "devDependencies": {
    "ali-oss": "6.23.0",
    "esbuild": "^0.28.1",
    "lucide-react": "0.546.0",
    "prettier": "^3.5.3",
    "sharp": "0.35.3",
    "typescript": "5.9.3"
  }
}
