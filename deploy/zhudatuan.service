[Unit]
Description=zhudatuan.com - Smart Wing Welfare Mall
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/zhudatuan
ExecStart=/usr/bin/node --env-file=/opt/zhudatuan/.env.production node_modules/vinext/dist/cli.js start
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
# 生产环境必须禁用开发模式
Environment=APP_ENV=production
Environment=AUTH_MODE=production
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SESSION_SIGNING_KEY /
# PII_ENCRYPTION_KEY / DEMO_LOGIN_CODE come from .env.production above
# (created from .env.example on the server, never committed to git).

# 资源限制
LimitAS=2G
LimitRSS=1G
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
